---
interface Props {
  service: string;
}

const { service } = Astro.props;
---

<span class:list={['service-icon', `service-icon--${service}`]} aria-hidden="true">
  {service === 'mot' && (
    <svg viewBox="0 0 48 48">
      <path d="M14 7h20v34H14z" />
      <path d="M19 14h10M19 21h10M19 28h6" />
      <path class="icon-accent" d="m27 34 3 3 6-7" />
    </svg>
  )}
  {service === 'tyres' && (
    <svg viewBox="0 0 48 48">
      <circle cx="24" cy="24" r="17" />
      <circle cx="24" cy="24" r="8" />
      <path d="m14 11 4 5M24 7v7M34 11l-4 5M41 24h-7M37 34l-5-4M24 41v-7M11 34l5-4M7 24h7" />
    </svg>
  )}
  {service === 'servicing' && (
    <svg viewBox="0 0 48 48">
      <path d="M29 9a10 10 0 0 0-9 14L8 35l5 5 12-12a10 10 0 0 0 14-9l-7 5-8-8 5-7Z" />
      <path class="icon-accent" d="m11 34 3 3" />
    </svg>
  )}
  {service === 'repairs' && (
    <svg viewBox="0 0 48 48">
      <path d="M9 30c1-4 2-8 4-11 1-2 3-4 6-4h10c3 0 5 2 6 4 2 3 3 7 4 11-5 1-10 2-15 2s-10-1-15-2Z" />
      <path d="M8 30v5c0 2 1 3 3 3h2l2-4h18l2 4h2c2 0 3-1 3-3v-5M15 25c6-1 12-1 18 0" />
      <circle class="icon-accent" cx="16" cy="30" r="2" />
      <circle class="icon-accent" cx="32" cy="30" r="2" />
    </svg>
  )}
  {service === 'diagnostics' && (
    <svg viewBox="0 0 48 48">
      <rect x="9" y="9" width="30" height="25" rx="3" />
      <path class="icon-accent" d="M15 26h5l3-9 4 12 3-6h4" />
      <path d="M17 34v5M31 34v5M14 39h20" />
    </svg>
  )}
  {service === 'pickup-drop-off' && (
    <svg viewBox="0 0 48 48">
      <path d="M7 29c1-4 3-8 5-11 2-2 4-3 7-3h10c3 0 5 1 7 3 2 3 4 7 5 11-5 2-11 3-17 3S12 31 7 29Z" />
      <path d="M9 29v4c0 2 1 3 3 3h2l2-4h16l2 4h2c2 0 3-1 3-3v-4" />
      <path class="icon-accent" d="M17 10h15m0 0-4-4m4 4-4 4" />
    </svg>
  )}
</span>

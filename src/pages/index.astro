---
import Layout from '../layouts/Layout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services, site } from '../data/site';
---

<Layout title="Servicing, MOT, repairs & tyres in Surbiton" description="FJD Autos is a family-run garage in Surbiton offering servicing, MOT, repairs, tyres and diagnostics for all makes and models. Call 020 8390 2542.">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> YOUR FAMILY-RUN GARAGE IN SURBITON</p>
      <h1>Good care.<br />More miles<span class="accent">.</span></h1>
      <p class="lead">Servicing, MOT, repairs and tyres for all makes and models. From the everyday service to the unexpected repair, your car is in experienced hands.</p>
      <a class="button" href="/enquiry/">Let’s talk about your car <span aria-hidden="true">↗</span></a>
      <p class="quiet">Prefer a conversation? <a href={site.phoneHref}>Call {site.phone}</a>.</p>
    </div>
    <div class="workshop-art">
      <div class="art-top"><span>FJD / WORKSHOP</span></div>
      <div class="wheel" aria-hidden="true"><div class="wheel-inner"><i></i><i></i><i></i><i></i><i></i><div class="hub">FJD</div></div></div>
      <a class="art-bottom" href="/enquiry/"><span>READY FOR<br />THE ROAD AHEAD.</span><span class="art-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="about" class="about-section wrap">
    <div><p class="eyebrow">A LOCAL GARAGE. A PERSONAL APPROACH.</p><h2>Family-run.<br />Here for your car.</h2></div>
    <div><p class="lead">FJD Autos is a long-established vehicle repair business in Surbiton, looking after all makes and models.</p><p>Our qualified, experienced technicians offer friendly service, competitive prices and diagnostic equipment to help get to the bottom of vehicle faults.</p><a class="text-link" href="/enquiry/?service=Something%20else">Ask us for advice ↗</a></div>
  </section>

  <section id="services" class="services-section">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">01 / UNDER THE BONNET</p><h2>What does your car need?</h2></div><p>A little routine care.<br />Or a problem that needs a closer look.</p></div>
      <div class="service-grid">
        {services.map((service, index) => <a class="service-card" href={`/services/${service.slug}/`}><span class="service-card-top"><span class="service-number">0{index + 1}</span><ServiceIcon service={service.slug} /><span class="service-arrow">↗</span></span><h3>{service.name}</h3><p>{service.short}</p><span class="text-link">Find out more</span></a>)}
      </div>
    </div>
  </section>

  <section id="how-it-works" class="process wrap">
    <div><p class="eyebrow">02 / LET’S KEEP IT SIMPLE</p><h2>Less back and forth.<br />More getting on with it.</h2><a class="text-link" href="/enquiry/">Start your enquiry ↗</a></div>
    <ol>
      <li><span>01</span><div><h3>Tell us about your car</h3><p>Share your registration, what you need and a date that suits you.</p></div></li>
      <li><span>02</span><div><h3>We’ll get in touch</h3><p>We’ll discuss the work and availability before confirming a booking.</p></div></li>
      <li><span>03</span><div><h3>Bring it in, or we can pick it up</h3><p>Drop your vehicle off at the agreed time, or ask us to arrange collection when we confirm your booking.</p></div></li>
    </ol>
  </section>

  <section id="contact" class="contact-section wrap">
    <div>
      <p class="eyebrow">03 / GET IN TOUCH</p>
      <div class="contact-heading"><h2>Let’s talk cars.</h2><a class="button small contact-call" href={site.phoneHref}>Call {site.phone}</a></div>
      <address class="contact-address">134 Tolworth Broadway<br />Surbiton, Surrey<br />KT6 7HT</address>
      <a class="garage-map" data-map-link href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address)}`} target="_blank" rel="noopener noreferrer" aria-label="Get directions to FJD Autos">
        <img src="/images/fjd-location-map.png" alt="Map showing FJD Autos beside Tolworth Broadway and the A3" width="1280" height="600" loading="lazy" />
        <span class="map-site-pin" aria-hidden="true"><span></span></span>
        <span class="map-location-name">FJD Autos</span>
        <span class="map-action">Get directions <span aria-hidden="true">↗</span></span>
      </a>
    </div>
    <div class="contact-opening"><h3>Opening hours</h3><dl class="opening-hours">{site.openingHours.map(item => <div class:list={{ 'day-closed': item.hours === 'Closed' }}><dt>{item.days}</dt><dd>{item.hours}</dd></div>)}</dl></div>
  </section>

  <section class="area-section wrap"><h2>Local drivers. Local fleets.</h2><p>Car repairs, tyres and MOT for vehicle owners and fleets across {site.areasServed.join(', ')}.</p></section>

  <section class="cta wrap">
    <div class="cta-copy"><p class="eyebrow">LET’S GET STARTED</p><h2>A little attention.<br />A lot more peace of mind.</h2></div>
    <a class="booking-orbit" href="/enquiry/" aria-label="Book your visit"><span class="booking-circle" aria-hidden="true"><svg viewBox="0 0 180 180" fill="none"><defs><path id="booking-text-curve" d="M 20,90 A 70,70 0 0,0 160,90" /></defs><text class="booking-curved-label" text-anchor="middle"><textPath href="#booking-text-curve" startOffset="50%">BOOK YOUR VISIT</textPath></text><path class="booking-arrow" d="M45 90h78M100 67l23 23-23 23" /></svg></span></a>
  </section>
</Layout>
<script>
  const mapLink = document.querySelector<HTMLAnchorElement>('[data-map-link]');
  if (mapLink) {
    const address = '134 Tolworth Broadway, Surbiton, Surrey, KT6 7HT';
    if (/Android/i.test(navigator.userAgent)) {
      mapLink.href = `geo:51.37928,-0.28130?q=${encodeURIComponent(address)}`;
      mapLink.removeAttribute('target');
    }
  }
</script>

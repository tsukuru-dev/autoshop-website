---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site';
---
<Layout title="Car servicing & repairs" description="Get in touch about your car’s servicing, repairs or diagnostics. Send a booking enquiry to FJD Autos.">
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> YOUR CAR. OUR NEXT JOB.</p><h1>Good care.<br />More miles<span class="accent">.</span></h1><p class="lead">From the everyday service to the unexpected repair. Tell us what your car needs, and let’s take it from there.</p><a class="button" href="/enquiry/">Let’s talk about your car <span aria-hidden="true">↗</span></a><p class="quiet">Send an enquiry. We’ll get in touch to arrange the details.</p></div>
    <div class="workshop-art" aria-hidden="true"><div class="art-top"><span>FJD / WORKSHOP</span><span>01 — KEEP MOVING</span></div><div class="wheel"><div class="wheel-inner"><i></i><i></i><i></i><i></i><i></i><div class="hub">FJD</div></div></div><div class="art-bottom"><span>READY FOR<br />THE ROAD AHEAD.</span><span class="art-arrow">↗</span></div></div>
  </section>
  <section id="services" class="services-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">01 / UNDER THE BONNET</p><h2>What does your car need?</h2></div><p>A little routine care.<br />Or a problem that needs a closer look.</p></div><div class="service-grid">{services.map((service, index) => <a class="service-card" href={`/services/${service.slug}/`}><span class="service-number">0{index + 1} <span>↗</span></span><h3>{service.name}</h3><p>{service.short}</p><span class="text-link">Find out more</span></a>)}</div></div></section>
  <section id="how-it-works" class="process wrap"><div><p class="eyebrow">02 / LET’S KEEP IT SIMPLE</p><h2>Less back and forth.<br />More getting on with it.</h2><a class="text-link" href="/enquiry/">Start your enquiry ↗</a></div><ol><li><span>01</span><div><h3>Tell us about your car</h3><p>Share your registration, what you need and a date that suits you.</p></div></li><li><span>02</span><div><h3>We’ll get in touch</h3><p>We’ll discuss the work and availability before confirming a booking.</p></div></li><li><span>03</span><div><h3>Bring it in</h3><p>Once the details are agreed, bring your vehicle in at the arranged time.</p></div></li></ol></section>
  <section class="cta wrap"><p class="eyebrow">LET’S GET STARTED</p><h2>A little attention.<br />A lot more peace of mind.</h2><a class="button light" href="/enquiry/">Request a booking <span aria-hidden="true">↗</span></a></section>
</Layout>

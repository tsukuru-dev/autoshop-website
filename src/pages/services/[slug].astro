---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/site';
export function getStaticPaths() { return services.map(service => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<Layout title={service.name} description={service.description}>
  <section class="page-intro wrap narrow"><a class="text-link" href="/#services">← All services</a><p class="eyebrow">CARE FOR YOUR CAR</p><h1>{service.name}<span class="accent">.</span></h1><p class="lead">{service.short}</p><p>{service.description}</p><h2>Let’s arrange the next step.</h2><p>Include your registration and preferred date. We’ll contact you to discuss your enquiry and confirm availability.</p><a class="button" href={`/enquiry/?service=${encodeURIComponent(service.name)}`}>Enquire about {service.name.toLowerCase()} ↗</a></section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site';
const key = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Layout title="Request a booking or tyre quote" description="Contact FJD Autos in Surbiton for servicing, MOTs, repairs, diagnostics or a free tyre quote.">
  <section class="enquiry-layout wrap"><div class="enquiry-intro"><p class="eyebrow">LET’S GET YOU MOVING</p><h1>Your car.<br />What’s next<span class="accent">?</span></h1><p class="lead">Tell us a little about what you need. We’ll get in touch to arrange the details.</p></div>
  <form id="enquiry-form" class="enquiry-form" action="/api/enquiry" method="post" novalidate>
    <h2>Request a booking</h2>
    <p class="form-intro">All fields are required unless marked optional.</p>
    <section class="form-section" aria-labelledby="details-section-title">
    <h3 id="details-section-title" class="form-section-title">01 / WHO</h3>
    <div class="form-grid">
      <label class="form-field"><span class="field-label">Your name</span><input name="name" autocomplete="name" maxlength="100" required /></label>
      <label class="form-field"><span class="field-label">Phone number</span><input name="phone" type="tel" autocomplete="tel" maxlength="30" required /></label>
    </div>
    <label class="form-field"><span class="field-label">Email address</span><input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
    <label class="form-field"><span class="field-label">Vehicle registration</span><input name="registration" class="registration" maxlength="15" required autocapitalize="characters" /></label>
    </section>
    <section class="form-section" aria-labelledby="work-section-title">
    <h3 id="work-section-title" class="form-section-title">02 / WHAT</h3>
    <fieldset class="form-field choice-fieldset service-fieldset">
      <legend class="field-label">What can we help with?</legend>
      <p class="field-hint">Choose all that apply.</p>
      <div class="service-options">
        {services.map(service => (
          <label class="service-option">
            <input type="checkbox" name="service" value={service.name} />
            <span>{service.name}</span>
          </label>
        ))}
        <label class="service-option">
          <input type="checkbox" name="service" value="Something else" />
          <span>Something else</span>
        </label>
      </div>
    </fieldset>
    <label class="form-field"><span class="field-label">Tell us a little more <span class="optional-label">(optional)</span></span><textarea name="message" rows="4" maxlength="3000" placeholder="What’s happening with your car? Include the make, model and any helpful details."></textarea></label>
    </section>
    <section class="form-section" aria-labelledby="timing-section-title">
    <h3 id="timing-section-title" class="form-section-title">03 / WHEN</h3>
    <fieldset class="form-field choice-fieldset urgency-fieldset">
      <legend class="field-label">How soon do you need the work done?</legend>
      <div class="urgency-options">
        <label class="urgency-option"><input type="radio" name="urgency" value="As soon as possible" required /><span>As soon as possible <small class="option-aside">(like yesterday - super urgent)</small></span></label>
        <label class="urgency-option"><input type="radio" name="urgency" value="Within the next few days" /><span>Within the next few days <small class="option-aside">(urgently, pretty please)</small></span></label>
        <label class="urgency-option"><input type="radio" name="urgency" value="Within a week" /><span>Within a week</span></label>
        <label class="urgency-option"><input type="radio" name="urgency" value="I’m flexible" /><span>I’m flexible</span></label>
        <label class="urgency-option"><input type="radio" name="urgency" value="I have a specific date" /><span>I have a specific date</span></label>
      </div>
    </fieldset>
    <p id="specific-date-notice" class="booking-notice" hidden>Your preferred date isn’t a confirmed appointment. We’ll confirm availability with you first.</p>
    <label id="specific-date-field" class="form-field" hidden><span class="field-label">Preferred date</span><input name="date" type="date" /></label>
    </section>
    <div class="honeypot" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    {key && <><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><div class="cf-turnstile" data-sitekey={key} data-action="enquiry" data-theme="light"></div></>}
    <p class="form-privacy">We use your details to respond to your enquiry. Read our <a href="/privacy/">privacy notice</a>.</p>
    <div id="form-errors" class="form-errors" role="alert" tabindex="-1" hidden>
      <strong>Please fix the following:</strong>
      <ul></ul>
    </div>
    <button class="button" type="submit">Send enquiry <span aria-hidden="true">↗</span></button>
    <p id="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    <noscript><p>Please enable JavaScript to complete the spam protection and send your enquiry.</p></noscript>
  </form></section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  if (form) {
    const serviceCheckboxes = [...form.querySelectorAll<HTMLInputElement>('input[name="service"]')];
    const selected = new URLSearchParams(location.search).get('service');
    const selectedCheckbox = serviceCheckboxes.find(checkbox => checkbox.value === selected);
    if (selectedCheckbox) selectedCheckbox.checked = true;
    const validateServices = () => {
      const firstCheckbox = serviceCheckboxes[0];
      firstCheckbox?.setCustomValidity(serviceCheckboxes.some(checkbox => checkbox.checked) ? '' : 'Choose at least one service.');
    };
    serviceCheckboxes.forEach(checkbox => checkbox.addEventListener('change', validateServices));
    validateServices();
    const date = form.elements.namedItem('date') as HTMLInputElement;
    date.min = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/London' }).format(new Date());
    const urgencyRadios = [...form.querySelectorAll<HTMLInputElement>('input[name="urgency"]')];
    const specificDateField = document.querySelector<HTMLElement>('#specific-date-field')!;
    const specificDateNotice = document.querySelector<HTMLElement>('#specific-date-notice')!;
    const updateDateField = () => {
      const needsDate = urgencyRadios.some(radio => radio.checked && radio.value === 'I have a specific date');
      specificDateField.hidden = !needsDate;
      specificDateNotice.hidden = !needsDate;
      date.required = needsDate;
      if (!needsDate) date.value = '';
    };
    updateDateField();
    const errorSummary = document.querySelector<HTMLElement>('#form-errors')!;
    const errorList = errorSummary.querySelector<HTMLUListElement>('ul')!;
    const clearErrors = () => {
      form.querySelectorAll('.field-error').forEach(error => error.remove());
      form.querySelectorAll('[aria-invalid="true"]').forEach(field => field.removeAttribute('aria-invalid'));
      errorList.replaceChildren();
      errorSummary.hidden = true;
    };
    const addError = (field: HTMLElement, container: HTMLElement, message: string) => {
      field.setAttribute('aria-invalid', 'true');
      const error = document.createElement('p');
      error.className = 'field-error';
      error.textContent = message;
      container.append(error);
      const item = document.createElement('li');
      item.textContent = message;
      errorList.append(item);
    };
    const validateForm = () => {
      clearErrors();
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const phone = form.elements.namedItem('phone') as HTMLInputElement;
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const registration = form.elements.namedItem('registration') as HTMLInputElement;
      const chosenUrgency = urgencyRadios.find(radio => radio.checked);
      if (!name.value.trim()) addError(name, name.closest('.form-field')!, 'Enter your name.');
      if (!/^[+\d\s().-]{7,30}$/.test(phone.value.trim()) || phone.value.replace(/\D/g, '').length < 7) addError(phone, phone.closest('.form-field')!, 'Enter a valid phone number.');
      if (!email.validity.valid || !email.value.trim()) addError(email, email.closest('.form-field')!, 'Enter a valid email address.');
      if (!/^[A-Za-z0-9 -]{2,15}$/.test(registration.value.trim())) addError(registration, registration.closest('.form-field')!, 'Enter a valid vehicle registration.');
      if (!serviceCheckboxes.some(checkbox => checkbox.checked)) addError(serviceCheckboxes[0], serviceCheckboxes[0].closest('.service-fieldset')!, 'Choose at least one service.');
      if (!chosenUrgency) addError(urgencyRadios[0], urgencyRadios[0].closest('.urgency-fieldset')!, 'Choose how soon you need the work done.');
      if (chosenUrgency?.value === 'I have a specific date' && (!date.value || !date.validity.valid)) addError(date, specificDateField, 'Choose a valid preferred date.');
      return errorList.children.length === 0;
    };
    let validationAttempted = false;
    const refreshErrors = () => {
      const valid = validateForm();
      errorSummary.hidden = valid;
      return valid;
    };
    urgencyRadios.forEach(radio => radio.addEventListener('change', () => {
      updateDateField();
      if (validationAttempted) refreshErrors();
    }));
    form.addEventListener('input', () => {
      if (validationAttempted) refreshErrors();
    });
    form.addEventListener('submit', async event => {
      event.preventDefault();
      validationAttempted = true;
      validateServices();
      if (!refreshErrors()) {
        errorSummary.focus();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button')!;
      const status = document.querySelector<HTMLElement>('#form-status')!;
      if (!document.querySelector('.cf-turnstile')) {
        status.textContent = 'Online enquiries are not configured yet. Please try again later.';
        status.focus();
        return;
      }
      button.disabled = true;
      status.textContent = 'Sending your enquiry…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'We couldn’t send your enquiry. Please try again.');
        form.reset();
        validationAttempted = false;
        clearErrors();
        updateDateField();
        status.textContent = 'Enquiry received. We’ll contact you to discuss the details and confirm availability.';
      } catch (error) { status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.'; }
      finally {
        button.disabled = false;
        const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
        turnstile?.reset();
        status.focus();
      }
    });
  }
</script>
